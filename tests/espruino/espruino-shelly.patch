diff --git a/boards/LINUX_SHELLY.py b/boards/LINUX_SHELLY.py
new file mode 100644
index 0000000..6c361bb
--- /dev/null
+++ b/boards/LINUX_SHELLY.py
@@ -0,0 +1,38 @@
+#!/bin/false
+# Linux build with the ESP32 variable format (16383 vars, 14 bit refs, JSVAR_MALLOC) for
+# measuring Shelly script memory. ESPRUINO_VARS sets the variable count at start up.
+# A 32-bit (i386) build has the 14 byte variables of the ESP32, a 64-bit build 18 bytes.
+import pinutils;
+info = {
+ 'name' : "Linux build with ESP32 variable format",
+ 'default_console' : "EV_USBSERIAL",
+ 'variables' : 16383,
+ 'binary_name' : 'espruino',
+ 'build' : {
+   'libraries' : [],
+   'makefile' : [
+     'DEFINES+=-DJSVAR_MALLOC',
+     'DEFINES+=-DUSE_CALLFUNCTION_HACK', # required by i386 builds, works on 64-bit too
+     'LINUX=1',
+   ]
+ }
+};
+chip = {
+  'part' : "LINUX",
+  'family' : "LINUX",
+  'package' : "",
+  'ram' : 0,
+  'flash' : 256,
+  'speed' : -1,
+  'usart' : 6,
+  'spi' : 3,
+  'i2c' : 3,
+  'adc' : 0,
+  'dac' : 0,
+};
+devices = {
+  'USB' : {}
+};
+def get_pins():
+  pins = pinutils.generate_pins(0,32)
+  return pins
