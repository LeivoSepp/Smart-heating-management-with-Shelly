+// Peak of jsvGetMemoryUsage() since the last jsvResetPeakMemoryUsage(), checked after every allocation
+static unsigned int peakMemoryUsage = 0;
+
+static void jsvUpdatePeakMemoryUsage() {
+  unsigned int usage = jsvGetMemoryUsage();
+  if (usage > peakMemoryUsage) peakMemoryUsage = usage;
+}
+
+unsigned int jsvGetPeakMemoryUsage() {
+  return peakMemoryUsage;
+}
+
+void jsvResetPeakMemoryUsage() {
+  peakMemoryUsage = jsvGetMemoryUsage();
+}
